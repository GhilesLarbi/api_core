# Which deployment this is: PRODUCTION, STAGING or LOCAL.
#
# Read by every service in compose — the api, the taskiq worker and scheduler,
# and the two web dev servers. It is the one switch that decides how each
# process runs and which public hostnames the backend hands out.
#
#   cp .env.example .env
#
# .env is git-ignored — never commit it.

ENVIRONMENT=LOCAL

# The host side of every published port. Two stacks on the same server cannot
# claim the same host port, so a second folder overrides these.

DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
SEAWEEDFS_MASTER_HOST_PORT=9333
SEAWEEDFS_VOLUME_HOST_PORT=9340
SEAWEEDFS_FILER_HOST_PORT=8888
SEAWEEDFS_S3_HOST_PORT=8333
SEAWEEDFS_ADMIN_HOST_PORT=23646
API_HOST_PORT=8000
WEB_USER_HOST_PORT=3000
WEB_ADMIN_HOST_PORT=3002
