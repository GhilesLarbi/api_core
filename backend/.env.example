# Backend environment template.
#
#   cp .env.example .env    then fill in every blank value.
#
# .env is git-ignored — never commit real credentials.
# Every field below is REQUIRED: app/core/secrets.py declares them without
# defaults, so a missing one fails at startup with a pydantic ValidationError.
#
# compose.yaml feeds this same file to api, worker, scheduler, db, redis and
# seaweedfs, which is why the container-side hosts/ports live here too.
# DATABASE_URL, REDIS_URL and SEAWEEDFS_S3_URL are NOT set here — they are
# derived properties on Secrets.

# ── Application ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SECRET_KEY="5oX2HJPNe0RDnrmuY3SRK8rWgf5RwQSOwbWzWFPBQrqqaTeD4RRff58oC5ppBgjv"

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# HOST/PORT are the compose service values; change them for a real deployment.
# These also configure the `db` container itself, so they must agree.
POSTGRES_DB="local"
POSTGRES_USER="TestUser"
POSTGRES_PASSWORD="Canyon6-Amber2-Quartz8-Tundra8"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_USER="RedisUser"
REDIS_PASSWORD="Granite1-Amber3-Copper7-Harbor3"
REDIS_HOST="redis"
REDIS_PORT="6379"

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_SERVER="smtp.example.com"
MAIL_PORT="465"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""

# ── SeaweedFS / S3 ───────────────────────────────────────────────────────────
# compose substitutes these two into backend/seaweedfs.json, replacing
# __ACCESS_KEY__ and __SECRET_KEY__ — the bucket identity and the app's client
# credentials are the same pair.
# PUBLIC_S3_URL is what presigned URLs are signed against, so it must be the
# address a browser can reach (not the internal service host).
SEAWEEDFS_HOST="seaweedfs"
SEAWEEDFS_S3_PORT="8333"
AWS_ACCESS_KEY_ID="d07466b50f8126056873e39dd7046fac"
AWS_SECRET_ACCESS_KEY="2d0a18311b224feaed4347f0696f843f4eb6bb6f7f95fa92c98379e62a590949"
